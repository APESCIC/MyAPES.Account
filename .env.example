# Local development with Laravel Herd (the only supported local setup).
# Profile values: docs/herd/profile.md. Production uses scripts/deploy/production.env.example.
APP_NAME="MyAPES Account"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://myapes-account.test

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Herd MySQL 8.4: this project's own database, root user, empty password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myapes_account_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# The Herd site is served over HTTPS (herd secure myapes-account), so cookies are secure-only.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
# CACHE_PREFIX=

# Herd's mail catcher: SMTP on 2525, read in Herd > Mail. Nothing is delivered.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@apes.org.uk"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="no-reply@apes.org.uk"
MAIL_REPLY_TO_NAME="MyAPES Account (do not reply)"

# Ticket and case replies by email (docs/mail.md). Off until a token key is set.
# Locally, `php artisan inbound-mail:key` writes INBOUND_MAIL_TOKEN_KEY; replies are
# fed in with `php artisan tickets:inbound-ingest`, so no IMAP mailbox is needed.
INBOUND_MAIL_ENABLED=false
INBOUND_MAIL_ADDRESS=communications@myapes.me.uk
INBOUND_MAIL_PLUS_ADDRESSING=true
INBOUND_MAIL_TOKEN_KEY=
INBOUND_MAIL_REQUIRE_AUTH=true
INBOUND_MAIL_AUTHSERV_ID=
INBOUND_MAIL_IMAP_HOST=
INBOUND_MAIL_IMAP_PORT=993
INBOUND_MAIL_IMAP_USERNAME=
INBOUND_MAIL_IMAP_PASSWORD=
# Local reply loop (docs/herd.md): set to mailpit to fetch replies from an optional standalone
# Mailpit instead of IMAP, with MAIL_PORT=1025 so ticket emails reach it. Local only; the
# Cloudron deploy preflight refuses anything but imap.
INBOUND_MAIL_DRIVER=imap
INBOUND_MAIL_MAILPIT_URL=http://127.0.0.1:8025

VITE_APP_NAME="${APP_NAME}"
# Vite dev server port for this project only; see docs/herd/profile.md.
VITE_PORT=5175

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://myapes-account.test/staff/auth/callback
OIDC_SCOPES=openid,profile,email
OIDC_STAFF_GROUPS=position.staff,position.students,position.volunteers
OIDC_ADMIN_GROUPS=intranet.administrator

LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_GROUPS_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(mail=%s)
LDAP_GROUP_ATTRIBUTE=memberOf
LDAP_START_TLS=false
LDAP_CONNECT_TIMEOUT_SECONDS=5
LDAP_SEARCH_TIMEOUT_SECONDS=10
DB_QUEUE_RETRY_AFTER=300
LDAP_SESSION_REVALIDATE_SECONDS=300
LDAP_SESSION_REVALIDATE_IN_LOCAL=false
DIRECTORY_SYNC_LOCK_SECONDS=300
MODULE_LOCK_SECONDS=15
MODULE_LOCK_WAIT_SECONDS=5
MODULE_PROJECTION_CACHE_SECONDS=30

AUDIT_LOG_RETENTION_DAYS=180

# Virus scanning for ticket and case uploads: disabled, clamd or fake (tests only).
ATTACHMENT_SCANNER=disabled
CLAMD_HOST=
CLAMD_PORT=3310

# Comma-separated staff email domains refused at public registration and email change.
MYAPES_STAFF_EMAIL_DOMAINS=apes.org.uk
CALL_LOG_RETENTION_MONTHS=24
CONTACT_CONSENT_POLICY_VERSION=2026-08
# Optional override. When empty, MyAPES Account uses the in-app /privacy page for notices and deploy preflight.
PRIVACY_NOTICE_URL=

# Optional: separate from APP_KEY so passkey user handles survive key rotation
# PASSKEYS_USER_HANDLE_SECRET=

# TinyMCE Cloud key; approve the site domain at tiny.cloud. Empty keeps plain textareas.
# Admins can also set it in Admin > Settings > Integrations; a value here wins.
TINYMCE_API_KEY=

# Google reCAPTCHA v3 on the public forms (#637). Usually set in Admin > Settings >
# Integrations instead; a value here wins. Keep real keys in APES Vault. Without keys,
# only the hidden honeypot and minimum fill time run.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
BOT_PROTECTION_ENABLED=true
