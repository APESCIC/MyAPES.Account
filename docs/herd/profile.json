{
    "project": "myapes-account",
    "herdSite": "myapes-account",
    "hostname": "myapes-account.test",
    "appUrl": "http://myapes-account.test",
    "documentRoot": "public",
    "webServer": "nginx",
    "php": "8.4",
    "phpIsolated": true,
    "phpExtensions": [
