{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.1",
        "giggsey/libphonenumber-for-php": "^9.0",
        "jumbojett/openid-connect-php": "^1.0",
        "laravel/framework": "^13.8",
        "laravel/passkeys": "^0.2.1",
        "laravel/tinker": "^3.0",
        "mews/purifier": "^3.4",
        "pragmarx/google2fa": "^9.1",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.7",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\ApesCic\\": "modules/apes-cic/src/",
            "Modules\\PetCareClinic\\": "modules/pet-care-clinic/src/",
            "Modules\\ShelterRescue\\": "modules/shelter-rescue/src/",
            "Plugins\\Tickets\\": "plugins/tickets/src/",
            "Plugins\\Cases\\": "plugins/cases/src/",
            "Plugins\\Recruitment\\": "plugins/recruitment/src/",
            "Plugins\\Consultations\\": "plugins/consultations/src/",
            "Plugins\\PetProfiles\\": "plugins/pet-profiles/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/local/dev-runner.mjs"
        ],
        "dev:docker": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/docker-preview.ps1"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "pre-merge": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -ExecutionPolicy Bypass -File scripts/local/pre-merge.ps1"
        ],
        "pre-pr-verify": [
            "Composer\\Config::disableProcessTimeout",
            "powershell -ExecutionPolicy Bypass -File scripts/local/pre-pr-verify.ps1"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
